MONITOR_NAME=raspberrypi-monitor

MQTT_HOST=core-mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

MQTT_BASE_TOPIC=monitor
DISCORD_ALERT_TOPIC=discord-ha/alerts

POLL_INTERVAL=15
PING_TIMEOUT=2
HEARTBEAT_INTERVAL=60

FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
MAX_WORKERS=10

HOSTS=proxmox=192.168.1.10,qnap=192.168.1.20,plex=192.168.1.30